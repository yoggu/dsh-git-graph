{
  "name": "dsh-git-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Git history and working-tree changes in the DSH web right sidebar: a commit graph, per-commit details, and a diff view for both past commits and an agent's uncommitted work",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build:syntax": "node scripts/build-syntax.js",
    "test:browser": "node tests/headless/run.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "highlight.js": "11.11.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright-core": "1.58.2",
    "pngjs": "7.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
